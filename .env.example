# Copy to .env and set the values for your environment.
GEMINI_API_KEY=
DATABASE_PATH=reservas.sqlite3
PORT=5000
FLASK_DEBUG=0

# Add the exact origins serving the website, separated by commas.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PUBLIC_BASE_URL=http://localhost:8000

# SMTP settings. For STARTTLS, use port 587. For implicit SSL, set SMTP_SSL=1.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
SMTP_SSL=0
HOTEL_EMAIL=hotelPrincessLaPalma@gmail.com
